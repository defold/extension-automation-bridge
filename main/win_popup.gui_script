local HOLD_ACTION = hash("hold_timer")
local MAX_HOLD_SECONDS = 60

local function set_hold_timer_text(self, prefix)
	local elapsed = math.min(self.hold_elapsed, MAX_HOLD_SECONDS)
	gui.set_text(gui.get_node("hold_timer"), string.format("%s: %.2fs / %ds", prefix, elapsed, MAX_HOLD_SECONDS))
end

local function set_popup_enabled(enabled)
	gui.set_enabled(gui.get_node("overlay"), enabled)
	gui.set_enabled(gui.get_node("panel"), enabled)
	gui.set_enabled(gui.get_node("title"), enabled)
	gui.set_enabled(gui.get_node("restart"), enabled)
	gui.set_enabled(gui.get_node("restart_text"), enabled)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.hold_elapsed = 0
	self.hold_active = false
	set_hold_timer_text(self, "Hold SPACE")
	set_popup_enabled(false)
end

function update(self, dt)
	if not self.hold_active then
		return
	end

	self.hold_elapsed = math.min(self.hold_elapsed + dt, MAX_HOLD_SECONDS)
	set_hold_timer_text(self, "Holding SPACE")
end

function final(self)
	msg.post(".", "release_input_focus")
end

function on_message(self, message_id)
	if message_id == hash("show_win") then
		set_popup_enabled(true)
	elseif message_id == hash("hide_win") then
		set_popup_enabled(false)
	end
end

function on_input(self, action_id, action)
	if action_id == HOLD_ACTION then
		if action.pressed then
			self.hold_elapsed = 0
			self.hold_active = true
			set_hold_timer_text(self, "Holding SPACE")
		elseif action.released then
			self.hold_active = false
			set_hold_timer_text(self, "Last SPACE hold")
		end
		return true
	end

	if action_id ~= hash("touch") or not action.released then
		return false
	end

	local panel = gui.get_node("panel")
	if not gui.is_enabled(panel) then
		return false
	end

	if gui.pick_node(gui.get_node("restart"), action.x, action.y) then
		msg.post("main:/controller#script", "restart")
		return true
	end

	return gui.pick_node(panel, action.x, action.y)
end
